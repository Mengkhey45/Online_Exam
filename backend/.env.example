# Examroom backend environment (AGENTS §9). Copy to .env and fill in.
# The API server refuses to start if any required value is missing.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Supabase Postgres — use the pooled connection string.
DATABASE_URL=postgresql://postgres:[Pass_of_Oline_Exam]@db.sbwzathjionjlzxnuvme.supabase.co:5432/postgres

# Supabase project. Access tokens are verified via the project's JWKS URL
# (derived from SUPABASE_URL) — no JWT secret needed.
SUPABASE_URL=https://sbwzathjionjlzxnuvme.supabase.co
# Publishable key (Settings -> API Keys -> Publishable key), client-safe.
SUPABASE_ANON_KEY=sb_publishable_...
# Secret key (Settings -> API Keys -> Secret keys -> create/reveal).
# Used ONLY by the worker, never the API server.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Signs attempt-session tokens for keyless students sitting an exam (§7).
# Any long random string (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTEMPT_TOKEN_SECRET=change-me-to-a-long-random-string-min-32-chars

# Optional integrations (features degrade gracefully until set).
ANTHROPIC_API_KEY=
RESEND_API_KEY=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
SENTRY_DSN=




# NOTE: real secrets belong in .env (gitignored), NOT here. The variable names
# the code reads are SUPABASE_ANON_KEY (= publishable key) and
# SUPABASE_SERVICE_ROLE_KEY (= secret key). No JWKS var needed — derived from URL.
#   SUPABASE_URL=https://<ref>.supabase.co
#   SUPABASE_ANON_KEY=sb_publishable_...
#   SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   (secret — .env only)